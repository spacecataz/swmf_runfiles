#ECHO
T                           DoEcho

Don't overlap gm/ua!
#COMPONENTMAP               For 400+ cores like production run
GM  0 -400 -1  -1           GM runs on 0:nProc-400 multithreaded
IE -2 -1  1                 IE runs on last 2 PE-s
IM -2 -2  1                 IM runs on nProc-2 PE
UA -400 -1 1                UA requires 400 processors.

#DESCRIPTION
St. Patrick's Day Storm event WITH GITM coupling.

#TIMEACCURATE
F                           DoTimeAccurate

#STARTTIME
2015                        year
03                          month
16                          day
00                          hour
00                          minute
00                          second
0.0                         FracSecond

! Allow empty processor for IM
#STRICT
F                           UseStrict

#COMPONENT
IM                          NameComp
F                           UseComp

#COMPONENT
UA                          NameComp
F                           UseComp

#COUPLE2
GM                          NameComp1
IE                          NameComp2
10                          DnCouple
-1.0                        DtCouple

#CHECKTIMESTEP
F                           DoCheckTimeStep (rest is read if true)

#BEGIN_COMP GM ---------------------------------------------------------------

#GRID
1                           nRootBlock_D(x_)
1                           nRootBlock_D(y_)
1                           nRootBlock_D(z_)
-224.                       xMin
 32.                        xMax
-128.                       yMin
 128.                       yMax
-128.                       zMin
 128.                       zMax

! Maximum resolution initially
#GRIDRESOLUTION
2.0                         Resolution
initial                     NameArea

! Minimum resolution in the computational domain
#GRIDRESOLUTION
8.0                         Resolution
all                         NameArea

#GRIDRESOLUTION
1.0                         Resolution
box                         NameArea
-100.0                      xMinBox
 -16.0                      yMinBox
 -16.0                      zMinBox
  22.0                      xMaxBox
  16.0                      yMaxBox
  16.0                      zMaxBox

 Better res at geosync and near tail.
#GRIDRESOLUTION
1/4                         one quarter orig
box
-20.0                       xMinBox
-8.0                        yMinBox
-8.0                        zMinBox
 8.0                        xMaxBox
 8.0                        yMaxBox
 8.0                        zMaxBox

! Close tail and bow shock resolution
#GRIDRESOLUTION
1/2                         Resolution
box
-32.0
-22.0
-10.0
 20.0
 22.0
 10.0                       zMaxBox

#GRIDRESOLUTION
1/8                         Resolution one eights orig
shell0                      NameArea
2.5                         r1Shell
3.5                         r2Shell

#BODY
T                           UseBody
2.5                         rBody     (in planet radius)
3.0                         rCurrents (in planet radius)
28.0                        BodyNDim  (/cc)
25000.0                     BodyTDim  (K)

#TIMESTEPPING
1                           nStage
0.80                        CflExlp

#OUTERBOUNDARY
outflow                     TypeBc1
vary                        TypeBc2
float                       TypeBc3
float                       TypeBc4
float                       TypeBc5
float                       TypeBc6

#INNERBOUNDARY
ionosphere                  TypeBcInner

! Set the inner boundary density as Rho0Cpcp + RhoPerCpcp*CPCP[keV]
#CPCPBOUNDARY
T                           UseCpcpBc  (rest is read if true)
28.0                        Rho0Cpcp   [amu/cc]
0.1                         RhoPerCpcp [amu/cc / keV]

#SOLARWINDFILE
T                           UseSolarWindFile
IMF.dat                     NameSolarWindFile

#SCHEME
1                           nOrder
Sokolov                     TypeFlux

#NONCONSERVATIVE
T                           UseNonConservative

#CONSERVATIVECRITERIA
1                           nConservCrit
parabola                    TypeConservCrit_I
 5.0                        xParabolaConserv
15.0                        yParabolaConserv

#SAVELOGNAME
F                           IsLogName_n
T                           IsLogName_e

#SAVEPLOTNAME
F                           IsPlotName_n
F                           IsPlotName_t
T                           IsPlotName_e

#PLOTFILENAME
date                        TimeUnitMax

#SAVELOGFILE
T                           DoSaveLo5Dgfile
VAR step date               StringLogfile
-1                          DnSaveLogfile
5.0                         DtSaveLogfile
dt rho mx my mz p bx by bz pmin pmax dst dst_sm cpcpn
3.0                         StringRFlux

#DOAMR
T                           DoAmr
100                         DnAmr
-1.0                        DtAmr
T                           IsStrictAmr

#MAGPERTURBINTEGRAL
T                           UseSurfaceIntegral
T                           UseFastFacIntegral
MAG                         TypeCoordIndex
MAG                         TypeCoordFacGrid

#GEOMAGINDICES
180                         nSizeKpWindow [min]
60.0                        DtOutput      [sec]

#MAGNETOMETERGRID
1                           nMagGridFile
global real8                TypeFileMagGrid
MAG                         TypeCoordMagGrid
72                          nLonMagGrid
32                          nLatMagGrid
0.                          LonMinMagGrid
360.                        LonMaxMagGrid
-80.                        LatMinMagGrid
80.                         LatMaxMagGrid
-1                          DnSaveMagGrid
60.0                        DtSaveMagGrid

#MAGNETOMETER
mags.dat                    NameMagInputFile
single                      TypeFileOut
-1                          DnOutput
60.0                        DtOutput

#SUPERMAGINDICES
T                           DoWriteSupermagIndices

#INCLUDE
sats.include

#END_COMP GM -----------------------------------------------------------------

#BEGIN_COMP IE ---------------------------------------------------------------

#AURORA
T
CMEE

SAVEPLOT
1                           nPlotFile
max idl                     StringPlot
100                         DnSavePlot
-1.0                        DtSavePlot

#END_COMP IE -----------------------------------------------------------------

#STOP
1000                        MaxIter
-1.                         TimeMax

#RUN    ######################################################################

#BEGIN_COMP GM ---------------------------------------------------------------

#DOAMR
F                           DoAmr

#SCHEME
2                           nOrder
Sokolov                     TypeFlux
mc3                         TypeLimiter
1.2                         BetaLimiter

#TIMESTEPPING
1                           nStage
0.60                        CflExlp

#END_COMP GM -----------------------------------------------------------------

#STOP
2000                        MaxIter
-1.                         TimeMax

#RUN    ######################################################################

#TIMEACCURATE
T                           DoTimeAccurate

#PROGRESS
100                         DnProgressShort
1000                        DnProgressLong

#SAVERESTART
T                           DoSaveRestart
-1                          DnSaveRestart
3600.0                      DtSaveRestart

#COMPONENT
IM                          NameComp
T                           UseComp

#COMPONENT
UA                          NameComp
T                           UseComp

! All processors are used now
#STRICT
T                           UseStrict

! Allow GM/IM and IE run in parallel. LAYOUT.in has to be properly set!
#COUPLEORDER
7                           nCouple
IE GM                       NameSourceTarget
IE IM                       NameSourceTarget
GM IE                       NameSourceTarget
GM IM                       NameSourceTarget
IM GM                       NameSourceTarget
IE UA                       NameSourceTarget
UA IE                       NameSourceTarget

#COUPLE2
GM                          NameComp1
IE                          NameComp2
-1                          DnCouple
5.0                         DtCouple

#COUPLE2
IM                          NameComp1
GM                          NameComp2
-1                          DnCouple
10.0                        DtCouple

#COUPLE1
IE                          NameComp1
IM                          NameComp2
-1                          DnCouple
10.0                        DtCouple

#COUPLE2
IE                          NameComp1
UA                          NameComp2
-1                          DnCouple
10.0                        DtCouple

#COUPLETIME
GM                          NameComp
F                           DoCoupleOnTime

#BEGIN_COMP GM ---------------------------------------------------------------

#IMCOUPLING
20.0                        TauCoupleIm
T                           DoImSatTrace
T                           DoCoupleImPressure
T                           DoCoupleImDensity
0.01                        DensityCoupleFloor
F                           DoFixPolarRegion

! Pressures below pMinDim are replaced with pMinDim.
#MINIMUMPRESSURE
1e-5                        pMinDim [nPa]

#SAVEPLOT
3                           nPlotFiles
y=0 MHD idl                 StringPlot
-1                          DnSavePlot
60.                         DtSavePlot
-1.0                        DxSavePlot
z=0 MHD idl                 StringPlot
-1                          DnSavePlot
60.                         DtSavePlot
-1.0                        DxSavePlot
z=0 ray idl                 StringPlot
-1                          DnSavePlot
60.                         DtSavePlot
-1.0                        DxSavePlot
3d MHD idl                  StringPlot
-1                          DnSavePlot
1800.                       DtSavePlot
-1                          DxSavePlot

#BORIS
T                           UseBorisCorrection
0.01                        BorisClightFactor

#REGION
borisregion                 NameArea
sphere tapered              NameShape
-4.0                        xPosition
0.0                         yPosition
0.0                         zPosition
14.0                        Radius
2.0                         Taper

#BORISREGION
borisregion                 NameBorisRegion

#TIMESTEPPING
1                           nStage
0.85                        CflExpl

#END_COMP GM -----------------------------------------------------------------

#BEGIN_COMP IM ---------------------------------------------------------------

! Number density fractions for H+ and O+. Has to add up to 1.0
#COMPOSITION
FIXED                       NameCompModel
0.8                         FractionH
0.2                         FractionO

! Decay for RCM particle densities
#DECAY
T                           UseDecay
10 hour                     DecayTimescale

#END_COMP IM -----------------------------------------------------------------

#BEGIN_COMP UA ---------------------------------------------------------------

#RESTART
F                           DoRestart

! Yields 1deg by 4deg. Each block has 9 cells by default; this is 180x90 cells.
#GRID
10                          lons
20                          lats
-90.0                       minimum latitude to model
90.0                        maximum latitude to model
0.0                         longitude to model (ignored in everything but 1D)
0.0                         set to 0 to model whole earth

#AUSMSOLVER
T

#LOGFILE
10.0                        DtWriteLog

#OUTPUTBACKEND
mpiio                       legacy (default) / mpiio / netcdf

NETCDFAPPEND
single                      none (default) / daily / single (only used when backend == netcdf)

#SAVEPLOTS
3600.0                      dt for writing restart files
3                           how many output files do you want
2DGEL                       output style
300.0                       dt for output
2DMEL
300.0
3DALL
900.0

#ELECTRODYNAMICS
swmf                        AuroralModel
10.0                        how often to update potential
swmf                        PotentialModel
10.0                        how often to update aurora and euv

#AURORATYPES
T                           UseDiffuseAurora (logical)
F                           UseMonoAurora (logical)
F                           UseWaveAurora (logical)
F                           UseIonAurora (logical)

#MSIS21
T

#APEX
F                           Use apex magnetic coordinate system

#DYNAMO
T                           UseDynamo
88.0                        DynamoHighLatBoundary
500                         nItersMax
1.0                         MaxResidual
F                           IncludeCowling
40.0                        LongitudinalAveraging
F                           UseNewTrace
T

#NGDC_INDICES
UA/DataIn/f107.txt          File is auto-parsed.

#EUV_DATA
T                                                                                  Use FISM solar flux data
UA/DataIn/FISM/fismflux_daily_2015.dat      Filename. Change the year!

#END_COMP UA -----------------------------------------------------------------

#BEGIN_COMP IE ---------------------------------------------------------------

#SAVEPLOT
1                           nPlotFile
max idl                     StringPlot
-1                          DnSavePlot
60.0                        DtSavePlot

#END_COMP IE -----------------------------------------------------------------

#ENDTIME
2015                        year
03                          month
19                          day
00                          hour
00                          minute
00                          second
0.0                         FracSecond

#END ############################################################
